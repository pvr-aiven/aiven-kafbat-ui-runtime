# Copy to .env (git-ignored) for the local run — or generate it with:
#   ./scripts/aiven-env.sh <aiven-project> <kafka-service>

# --- Kafka cluster -----------------------------------------------------------
KAFKA_CLUSTER_NAME=aiven-kafka
# IMPORTANT: the SASL listener port, not the mTLS one.
# Console > Kafka service > Overview > Connection information > SASL
KAFKA_BOOTSTRAP_SERVERS=kafka-xxxxxxx.aivencloud.com:12345
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=

# --- Schema Registry (Karapace) ---------------------------------------------
# Console > Kafka service > Overview > Connection information > Schema Registry
SCHEMA_REGISTRY_URL=https://kafka-xxxxxxx.aivencloud.com:12346
SCHEMA_REGISTRY_USER=avnadmin
SCHEMA_REGISTRY_PASSWORD=

# --- Kafka Connect (optional) ------------------------------------------------
#KAFKA_CONNECT_URL=https://kafka-connect-xxxxxxx.aivencloud.com:12347
#KAFKA_CONNECT_USER=avnadmin
#KAFKA_CONNECT_PASSWORD=

# --- UI ----------------------------------------------------------------------
# true = no write operation is possible from the UI.
KAFKA_CLUSTERS_0_READONLY=true

# The project CA goes in ./certs/ca.pem (mounted by compose.dev.yaml), not here:
# a multi-line PEM travels badly through a .env file.
