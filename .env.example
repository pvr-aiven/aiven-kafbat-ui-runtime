# Copy to .env (git-ignored) for the local run — or generate it with:
#   ./scripts/aiven-env.sh <aiven-project> <kafka-service> [cluster-index]
#
# Clusters are numbered from 0. Every variable below follows the pattern
# KAFKA_<index>_<SETTING>. Only BOOTSTRAP_SERVERS is mandatory: it is what
# declares that the cluster exists.

# =============================================================================
# Cluster 0 — Aiven for Apache Kafka, SASL_SSL / SCRAM
# =============================================================================
KAFKA_0_NAME=aiven-prod
# IMPORTANT: the SASL listener port, not the mTLS one.
# Console > Kafka service > Overview > Connection information > SASL
KAFKA_0_BOOTSTRAP_SERVERS=kafka-xxxxxxx.aivencloud.com:12345
KAFKA_0_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_0_SASL_USERNAME=avnadmin
KAFKA_0_SASL_PASSWORD=
# Aiven's CA is private, so it has to be supplied. Locally: a mounted file.
# On Runtime: paste the PEM into a KAFKA_0_CA_CERT secret instead.
KAFKA_0_CA_CERT_FILE=/certs/ca-0.pem
# Console > Kafka service > Overview > Connection information > Schema Registry
KAFKA_0_SCHEMA_REGISTRY_URL=https://kafka-xxxxxxx.aivencloud.com:12346
KAFKA_0_SCHEMA_REGISTRY_USER=avnadmin
KAFKA_0_SCHEMA_REGISTRY_PASSWORD=
#KAFKA_0_CONNECT_URL=https://kafka-connect-xxxxxxx.aivencloud.com:12347
#KAFKA_0_CONNECT_USER=avnadmin
#KAFKA_0_CONNECT_PASSWORD=
# true = no write operation is possible from the UI on this cluster.
KAFKA_0_READONLY=true

# =============================================================================
# Cluster 1 — a second Aiven service, e.g. another project or region
# =============================================================================
# A different project means a different CA: hence a second file.
#KAFKA_1_NAME=aiven-staging
#KAFKA_1_BOOTSTRAP_SERVERS=kafka-yyyyyyy.aivencloud.com:12345
#KAFKA_1_SASL_USERNAME=avnadmin
#KAFKA_1_SASL_PASSWORD=
#KAFKA_1_CA_CERT_FILE=/certs/ca-1.pem
#KAFKA_1_SCHEMA_REGISTRY_URL=https://kafka-yyyyyyy.aivencloud.com:12346
#KAFKA_1_SCHEMA_REGISTRY_USER=avnadmin
#KAFKA_1_SCHEMA_REGISTRY_PASSWORD=
#KAFKA_1_READONLY=false

# =============================================================================
# Cluster 2 — self-managed broker, no TLS, no auth
# =============================================================================
# With no credentials and no CA, the protocol is inferred as PLAINTEXT.
#KAFKA_2_NAME=self-managed-dev
#KAFKA_2_BOOTSTRAP_SERVERS=broker.internal:9092

# =============================================================================
# Cluster 3 — Confluent Cloud (SASL_SSL / PLAIN, publicly trusted CA)
# =============================================================================
# No CA needed: the certificate chain is in the JVM's default trust store.
#KAFKA_3_NAME=confluent
#KAFKA_3_BOOTSTRAP_SERVERS=pkc-xxxxx.eu-west-1.aws.confluent.cloud:9092
#KAFKA_3_SASL_MECHANISM=PLAIN
#KAFKA_3_SASL_USERNAME=<API key>
#KAFKA_3_SASL_PASSWORD=<API secret>

# =============================================================================
# Cluster 4 — Aiven with mTLS instead of SCRAM
# =============================================================================
# Supply the client key and certificate and the protocol is inferred as SSL.
#KAFKA_4_NAME=aiven-mtls
#KAFKA_4_BOOTSTRAP_SERVERS=kafka-zzzzzzz.aivencloud.com:12691
#KAFKA_4_CA_CERT_FILE=/certs/ca-4.pem
#KAFKA_4_ACCESS_KEY=
#KAFKA_4_ACCESS_CERT=
